+        // U5-B: load one packed BF16 pair, convert it to
+        // float2, then issue one aligned 64-bit shared store.
+        int bf16_off = int(bf16_view.layout()(r0, c0));
+        int fp32_off = int(fp32_view.layout()(r0, c0));
+
+        __nv_bfloat162 packed_bf16 =
+            *reinterpret_cast<__nv_bfloat162 const*>(
+                bf16_smem + bf16_off
+            );
+
+        float2 packed_fp32 =
+            __bfloat1622float2(packed_bf16);
+
+        *reinterpret_cast<float2*>(
+            fp32_smem + fp32_off
+        ) = packed_fp32;
     }
 }
 
