--- a/csrc/smxx/utils.cuh
+++ b/csrc/smxx/utils.cuh
@@ -2,6 +2,7 @@
 
 #include <cuda_runtime.h>
 #include <cuda_fp16.h>
+#include <cuda_bf16.h>
 #include <cuda/atomic>
 
 #include <cstdio>
@@ -355,8 +356,22 @@ __device__ void smem_cvt_fp32_to_bf16(
         int e1 = lane_id * 2 + 1;
         int r0 = br + e0 / kBlock, c0 = bc + e0 % kBlock;
         int r1 = br + e1 / kBlock, c1 = bc + e1 % kBlock;
