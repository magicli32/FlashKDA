     }
 }
 
@@ -385,8 +400,22 @@ __device__ void smem_cvt_bf16_to_fp32(
         int e1 = lane_id * 2 + 1;
         int r0 = br + e0 / kBlock, c0 = bc + e0 % kBlock;
